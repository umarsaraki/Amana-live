PORT=5000
JWT_SECRET=amana_live_super_secret_change_me

# CLIENT_URL matters mainly for local development (Vite dev server on :5173
# calling this API on :5000). In production the built frontend is served
# from this same server/origin, so it's not required for the app to work -
# it's only used for the CORS header and the Socket.io CORS config.
CLIENT_URL=http://localhost:5173

# PostgreSQL connection
# Option A: single connection string (most hosting platforms provide this
# automatically when you attach a Postgres database - just paste it here)
DATABASE_URL=postgres://amana_user:amana_pass@localhost:5432/amana_live

# Option B: individual fields (used only if DATABASE_URL is not set)
PGHOST=localhost
PGPORT=5432
PGUSER=amana_user
PGPASSWORD=amana_pass
PGDATABASE=amana_live
